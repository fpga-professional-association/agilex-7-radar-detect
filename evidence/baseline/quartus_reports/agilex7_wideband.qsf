# ---------------------------------------------------------------------------
# Agilex 7 Wideband Processing Benchmark — Quartus Prime Pro settings file
#
# Governing spec: SPEC.md 15 (Quartus Project), 17 (Reporting), 24 (Constraints
# integrity). Created by issue #3 (Phase 0).
#
# This file is HAND MAINTAINED and deliberately minimal. Do not open the
# project in the GUI and save it: the GUI appends tool bookkeeping
# that makes compile-to-compile diffs unreviewable. The Quartus version is
# detected at compile time by quartus/scripts/compile.tcl and recorded in the
# exported JSON (SPEC.md 17); it is intentionally NOT hardcoded here.
#
# All paths are relative to this directory (quartus/project/), so the project
# is position independent and works from a clean checkout on any host.
# ---------------------------------------------------------------------------

# --- device (SPEC.md 2, 15) -------------------------------------------------
set_global_assignment -name FAMILY "Agilex 7"
set_global_assignment -name DEVICE AGMF039R47B1E1VC
set_global_assignment -name TOP_LEVEL_ENTITY benchmark_fabric_top

# --- SystemVerilog macros ---------------------------------------------------
# Every simulation-only block in the RTL is guarded by `ifndef SYNTHESIS`;
# define it here so Quartus skips those blocks (assertions, shadow queues,
# elaboration $fatal checks, sim-only checker instantiations). Verilator
# does not need this -- it never defines SYNTHESIS.
set_global_assignment -name VERILOG_MACRO "SYNTHESIS=1"

# Include search path so `include "cdc_sva.svh"` inside `ifndef SYNTHESIS`
# blocks resolves cleanly on tool versions that eagerly resolve file-scope
# `include tokens before evaluating `ifdef` conditions.
set_global_assignment -name SEARCH_PATH ../../sim/assertions

# Operating conditions used for timing models. Full commercial range.
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100

# --- project output ---------------------------------------------------------
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

# --- design source (SPEC.md 10 layout) --------------------------------------
# Phase 5 (issue #20): benchmark_fabric_top now wraps benchmark_pipeline_top,
# so the whole file list must be included. Order matches
# sim/verilator/files_pipeline.f: packages first, then RTL bottom-up.

# ---- shared packages ----
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/fxp_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/stream_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/cdc_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/pfb_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/covar_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/cfar_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/history_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/packet_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/beamformer/beamformer_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/align/align_pkg.sv

# ---- issue #19 abstract memory ----
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/memory/mem_req_rsp_if.sv

# ---- generated Phase-5 configuration package ----
# The generated config_pkg.sv is written by scripts/build_verilator.py from
# config/full_agmf039.json. Copy to sim/verilator/generated/ before compile.
set_global_assignment -name SYSTEMVERILOG_FILE ../../sim/verilator/generated/config_pkg.sv

# ---- stream primitives (SPEC 5) ----
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/stream/stream_skid_buffer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/stream/stream_elastic_buffer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/stream/stream_pipe.sv

# ---- SPEC 8 CDC primitives ----
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cdc/cdc_sync2.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cdc/cdc_pulse.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cdc/cdc_handshake.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cdc/async_fifo.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cdc/stream_cdc.sv

# ---- SPEC 6/9 common RTL ----
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/common/fxp_sticky_flags.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/common/perf_counter.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/common/seq_checker.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/common/complex_multiplier.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/common/sync_fifo.sv

# ---- kernels ----
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/pfb/delay_line.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/pfb/coeff_bank.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/pfb/fir_lane.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/pfb/pfb_bank.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/fft/generated/fft_twiddle_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/fft/fft_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/fft/fft_delay_line.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/fft/fft_bf2.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/fft/fft_twiddle_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/fft/fft_radix22_stage.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/fft/fft_sdf_path.sv
