# Claude Code local settings
.claude/settings.local.json

# Pre-repo scratch Quartus shell (not part of the benchmark)
radar-detect.qpf
radar-detect.qsf
radar-detect.qws
dni/
qdb/

# Quartus generated outputs
output_files/
tmp-clearbox/
*.qws
*.qdb
quartus/project/qdb/
quartus/project/dni/
quartus/project/output_files/
quartus/project/tmp-clearbox/

# Verilator / simulation outputs
obj_dir/
*.fst
*.fst.hier
*.vcd
sim/verilator/build*/

# Standalone C++ reference-model build (make numerics-check).
#
# NOTE: model/vectors/*.vec is deliberately NOT ignored. Those files are
# committed source-of-truth golden vectors — the point of a golden vector is
# that a change to it appears as a reviewable diff — not build output. They are
# regenerated and compared, not rebuilt, by `make numerics-check`. See
# DECISIONS.md (issue #4).
model/cpp/build/

# Results are generated, never committed (dirs kept via .gitkeep).
# Note: pattern must not exclude the subdirectories themselves, or git cannot
# re-include the .gitkeep files beneath them.
results/*/*
!results/**/.gitkeep

# Python
__pycache__/
*.pyc
.venv/

# Editor / OS noise
*.swp
.DS_Store
Thumbs.db

# Generated Verilator config package / headers (from config/*.json)
sim/verilator/generated/
