# Claude Code local settings
.claude/settings.local.json

# Pre-repo scratch Quartus shell (not part of the benchmark)
radar-detect.qpf
radar-detect.qsf
radar-detect.qws
dni/
qdb/

# Quartus generated outputs
output_files/
tmp-clearbox/
*.qws
*.qdb
quartus/project/qdb/
quartus/project/dni/
