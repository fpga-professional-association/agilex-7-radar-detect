# Verilator / simulation outputs
obj_dir/
*.fst
*.fst.hier
*.vcd
sim/verilator/build*/

# Results are generated, never committed (dirs kept via .gitkeep).
# Note: pattern must not exclude the subdirectories themselves, or git cannot
# re-include the .gitkeep files beneath them.
results/*/*
!results/**/.gitkeep

# Python
__pycache__/
*.pyc
.venv/

# Editor / OS noise
*.swp
.DS_Store
Thumbs.db
