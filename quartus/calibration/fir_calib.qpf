# ---------------------------------------------------------------------------
# fir_calib.qpf — SPEC 18 resource-calibration project for one complex FIR lane
# (issue #10, SPEC.md 18 item 2).
#
# One revision. The sweep varies ELABORATION PARAMETERS, not revision settings,
# for the reason quartus/calibration/cmult_calib.qpf gives: a revision per point
# would put the sweep's state in tracked files instead of in the exported JSON
# record. scripts/run_calibration.py recompiles this single revision once per
# point and exports one record per point; the parameters that produced each
# record are IN the record.
#
# Hand-maintained: do not let the GUI rewrite this file with tool metadata.
# ---------------------------------------------------------------------------

QUARTUS_VERSION = "26.1"

# Revisions

PROJECT_REVISION = "fir_calib"
