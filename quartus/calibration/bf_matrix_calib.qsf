# ---------------------------------------------------------------------------
# bf_matrix_calib.qsf — SPEC 18 calibration project settings for one beamforming
# matrix slice (issue #12, SPEC 18 item 7).
#
# SAME DEVICE as the benchmark project and as every other calibration project in
# this directory: AGMF039R47B1E1VC, same speed grade, same junction-temperature
# range. A calibration number measured on a different device or a different
# operating range is not calibration data for this benchmark.
#
# HAND MAINTAINED. quartus/scripts/calibrate.tcl exports the in-memory assignment
# database over this file and restores these exact bytes afterwards; do not open
# the project in the GUI and save it.
#
# All paths are relative to this directory (quartus/calibration/).
# ---------------------------------------------------------------------------

# --- device (SPEC.md 2, 15) -------------------------------------------------
set_global_assignment -name FAMILY "Agilex 7"
set_global_assignment -name DEVICE AGMF039R47B1E1VC
set_global_assignment -name TOP_LEVEL_ENTITY bf_matrix_wrap

set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100

# --- project output ---------------------------------------------------------
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

# --- simulation-only code exclusion -----------------------------------------
# See bf_dot_calib.qsf. Without this the measured counts would include every
# `ifndef SYNTHESIS block in the beamformer, the weight bank, the reused
# coefficient store and their checkers.
set_global_assignment -name VERILOG_MACRO "SYNTHESIS=1"

# --- design source ----------------------------------------------------------
# Order matters: packages first. Every file is the SAME FILE the simulation
# builds and lints.
#
# rtl/packages/pfb_pkg.sv and rtl/pfb/coeff_bank.sv appear here because
# rtl/beamformer/weight_bank.sv REUSES the dual-bank store issue #10 built rather
# than containing a second copy of a clock-domain seam and a swap state machine.
# See that file's section 1.
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/fxp_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/stream_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/cdc_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/pfb_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/beamformer/beamformer_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cdc/cdc_sync2.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cdc/cdc_pulse.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cdc/cdc_handshake.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/common/fxp_sticky_flags.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/common/perf_counter.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/common/complex_multiplier.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/stream/stream_skid_buffer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/stream/stream_elastic_buffer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/pfb/coeff_bank.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/beamformer/bf_dot.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/beamformer/weight_bank.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/beamformer/beamformer.sv
set_global_assignment -name SYSTEMVERILOG_FILE bf_matrix_wrap.sv

# --- timing constraints -----------------------------------------------------
set_global_assignment -name SDC_FILE bf_matrix_calib.sdc

# ---------------------------------------------------------------------------
# Virtual pins
# ---------------------------------------------------------------------------
# Same rationale as every other calibration project: a FABRIC measurement, not a
# pinout exercise. The input payload alone is 1048 bits — a beamformer beat
# carries BIN_PAR bins each with the whole antenna vector — so without virtual
# pins this would not fit any package on the device, let alone measure the
# matrix. clk and rst_n stay real pins so they get genuine global networks.
set_instance_assignment -name VIRTUAL_PIN ON -to s_valid
set_instance_assignment -name VIRTUAL_PIN ON -to s_ready
set_instance_assignment -name VIRTUAL_PIN ON -to "s_payload[*]"

set_instance_assignment -name VIRTUAL_PIN ON -to m_valid
set_instance_assignment -name VIRTUAL_PIN ON -to m_ready
set_instance_assignment -name VIRTUAL_PIN ON -to "m_payload[*]"

set_instance_assignment -name VIRTUAL_PIN ON -to cfg_wr_valid
set_instance_assignment -name VIRTUAL_PIN ON -to cfg_wr_ready
set_instance_assignment -name VIRTUAL_PIN ON -to cfg_wr_bank
set_instance_assignment -name VIRTUAL_PIN ON -to "cfg_wr_addr[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "cfg_wr_data[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to cfg_swap_req
set_instance_assignment -name VIRTUAL_PIN ON -to cfg_status

set_instance_assignment -name VIRTUAL_PIN ON -to telem_clear
set_instance_assignment -name VIRTUAL_PIN ON -to telem_snapshot
set_instance_assignment -name VIRTUAL_PIN ON -to "telem_status[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "tput_status[*]"
