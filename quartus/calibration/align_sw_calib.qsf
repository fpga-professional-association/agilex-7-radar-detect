# ---------------------------------------------------------------------------
# align_sw_calib.qsf — SPEC 18 / SPEC 7.4 calibration project settings for the
# alignment network's routing fabric (issue #16).
#
# SAME DEVICE as the benchmark project and as every other calibration project in
# this directory: AGMF039R47B1E1VC, same speed grade, same junction-temperature
# range. A calibration number measured on a different device or a different
# operating range is not calibration data for this benchmark.
#
# HAND MAINTAINED. quartus/scripts/calibrate.tcl exports the in-memory assignment
# database over this file and restores these exact bytes afterwards; do not open
# the project in the GUI and save it.
#
# All paths are relative to this directory (quartus/calibration/).
# ---------------------------------------------------------------------------

# --- device (SPEC.md 2, 15) -------------------------------------------------
set_global_assignment -name FAMILY "Agilex 7"
set_global_assignment -name DEVICE AGMF039R47B1E1VC
set_global_assignment -name TOP_LEVEL_ENTITY align_sw_wrap

set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100

# --- project output ---------------------------------------------------------
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

# --- simulation-only code exclusion -----------------------------------------
# Every module in rtl/align/ guards its elaboration checks with
# `ifndef SYNTHESIS, the convention every block in this repository uses. Quartus
# does not define SYNTHESIS on its own, so this project defines it explicitly
# rather than relying on the tool silently ignoring an `initial` block. In this
# kernel the scaffolding includes align_clos's O(N^2) route_ok() proof, which is
# elaboration-time and free, and align_switch's latency-match report — neither of
# which should appear in a resource count.
set_global_assignment -name VERILOG_MACRO "SYNTHESIS=1"

# --- design source ----------------------------------------------------------
# Order matters: packages first. Every file is the SAME FILE the simulation
# builds and lints — there is no synthesis-only copy, which is the property that
# makes these numbers apply to the verified design.
#
# THE LIST IS SHORT ON PURPOSE. The routing fabric consumes no SPEC 5 payload and
# no history metadata: it moves DATA_W opaque bits from an input to the output
# its destination index names. align_pkg is here only because align_switch reads
# its architecture selector and its latency arithmetic, and history_pkg comes
# with it because align_pkg's width functions are stated in terms of #15's
# geometry. Anything more would be measured along with the fabric.
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/fxp_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/stream_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/history_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/align/align_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/align/align_xbar.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/align/align_clos.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/align/align_switch.sv
set_global_assignment -name SYSTEMVERILOG_FILE align_sw_wrap.sv

# --- timing constraints -----------------------------------------------------
set_global_assignment -name SDC_FILE align_sw_calib.sdc

# ---------------------------------------------------------------------------
# Virtual pins
# ---------------------------------------------------------------------------
# Same rationale as every other calibration project: a FABRIC measurement, not a
# pinout exercise. The routed word is 534 bits at the full-scale point and there
# are eight of them in and eight out, so without virtual pins this would not fit
# any package on the device, let alone measure the network. clk and rst_n stay
# real pins so they get genuine global networks — a kernel measured on a local
# clock tree would report an Fmax the real design can never reproduce.
set_instance_assignment -name VIRTUAL_PIN ON -to "in_valid[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "in_ready[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "in_data[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "in_dst[*]"

set_instance_assignment -name VIRTUAL_PIN ON -to "out_valid[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "out_ready[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "out_data[*]"

set_instance_assignment -name VIRTUAL_PIN ON -to "status[*]"
