# ---------------------------------------------------------------------------
# cmult_calib.qsf — SPEC 18 calibration project settings for the complex
# multiplier (issue #9).
#
# SAME DEVICE as the benchmark project (quartus/project/agilex7_wideband.qsf):
# AGMF039R47B1E1VC, same speed grade, same junction-temperature range. A
# calibration number measured on a different device or a different operating
# range is not calibration data for this benchmark, so the two files state the
# device identically and the exported record repeats it for every point.
#
# HAND MAINTAINED. quartus/scripts/calibrate.tcl lets Quartus export the
# in-memory assignment database over this file — it has to, because that export
# is how the swept `set_parameter` values reach quartus_syn — and then restores
# these exact bytes afterwards. So the sweep leaves no parameter, no seed and no
# tool bookkeeping behind. Do not open the project in the GUI and save it.
#
# All paths are relative to this directory (quartus/calibration/).
# ---------------------------------------------------------------------------

# --- device (SPEC.md 2, 15) -------------------------------------------------
set_global_assignment -name FAMILY "Agilex 7"
set_global_assignment -name DEVICE AGMF039R47B1E1VC
set_global_assignment -name TOP_LEVEL_ENTITY cmult_wrap

set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100

# --- project output ---------------------------------------------------------
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

# --- simulation-only code exclusion -----------------------------------------
# rtl/common/complex_multiplier.sv guards its elaboration checks and its
# shadow-pipeline proof assertions with `ifndef SYNTHESIS, the convention every
# primitive in this repository uses. Quartus does not define SYNTHESIS on its
# own, so the calibration project defines it explicitly rather than relying on
# the tool silently ignoring an `initial` block. Without this line the measured
# resource counts could include simulation scaffolding.
set_global_assignment -name VERILOG_MACRO "SYNTHESIS=1"

# --- design source ----------------------------------------------------------
# Order matters: the package first. The kernel is the SAME FILE the simulation
# builds and lints — there is no synthesis-only copy, which is the property that
# makes the calibration numbers apply to the verified design.
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/fxp_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/common/complex_multiplier.sv
set_global_assignment -name SYSTEMVERILOG_FILE cmult_wrap.sv

# --- timing constraints -----------------------------------------------------
set_global_assignment -name SDC_FILE cmult_calib.sdc

# ---------------------------------------------------------------------------
# Virtual pins
# ---------------------------------------------------------------------------
# Same rationale as the benchmark project: this is a FABRIC measurement, not a
# pinout exercise. Every data and handshake port is a virtual pin so the Fitter
# places no I/O buffers and the register-to-register paths inside the wrapper are
# what gets measured. core clock and reset stay real pins so they get genuine
# global networks — a kernel measured on a local clock tree would report an Fmax
# the real design can never reproduce.
set_instance_assignment -name VIRTUAL_PIN ON -to valid_in
set_instance_assignment -name VIRTUAL_PIN ON -to "a_re[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "a_im[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "b_re[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "b_im[*]"

set_instance_assignment -name VIRTUAL_PIN ON -to valid_out
set_instance_assignment -name VIRTUAL_PIN ON -to "p_re[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "p_im[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "y_re[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "y_im[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "flags_re[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "flags_im[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to ovf
