# ---------------------------------------------------------------------------
# fft_stage_calib.qsf — SPEC 18 calibration project settings for one radix-2^2
# FFT stage (issue #11, SPEC 18 item 4).
#
# SAME DEVICE as the benchmark project (quartus/project/agilex7_wideband.qsf):
# AGMF039R47B1E1VC, same speed grade, same junction-temperature range. A
# calibration number measured on a different device or a different operating
# range is not calibration data for this benchmark, so the two files state the
# device identically and the exported record repeats it for every point.
#
# HAND MAINTAINED. quartus/scripts/calibrate.tcl lets Quartus export the
# in-memory assignment database over this file — it has to, because that export
# is how the swept `set_parameter` values reach quartus_syn — and then restores
# these exact bytes afterwards. So the sweep leaves no parameter, no seed and no
# tool bookkeeping behind. Do not open the project in the GUI and save it.
#
# All paths are relative to this directory (quartus/calibration/).
# ---------------------------------------------------------------------------

# --- device (SPEC.md 2, 15) -------------------------------------------------
set_global_assignment -name FAMILY "Agilex 7"
set_global_assignment -name DEVICE AGMF039R47B1E1VC
set_global_assignment -name TOP_LEVEL_ENTITY fft_stage_wrap

set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100

# --- project output ---------------------------------------------------------
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

# --- simulation-only code exclusion -----------------------------------------
# Every module in rtl/fft/ guards its elaboration checks and its proof assertions
# with `ifndef SYNTHESIS, the convention every primitive in this repository uses.
# Quartus does not define SYNTHESIS on its own, so the calibration project
# defines it explicitly rather than relying on the tool silently ignoring an
# `initial` block. Without this line the measured resource counts would include
# simulation scaffolding — including fft_delay_line's shadow shift register,
# which is exactly as large as the delay line it checks.
set_global_assignment -name VERILOG_MACRO "SYNTHESIS=1"

# --- design source ----------------------------------------------------------
# Order matters: packages first. Every file is the SAME FILE the simulation
# builds and lints — there is no synthesis-only copy, which is the property that
# makes the calibration numbers apply to the verified design.
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/fxp_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/fft/generated/fft_twiddle_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/fft/fft_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/common/complex_multiplier.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/fft/fft_delay_line.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/fft/fft_bf2.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/fft/fft_twiddle_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/fft/fft_radix22_stage.sv
set_global_assignment -name SYSTEMVERILOG_FILE fft_stage_wrap.sv

# --- timing constraints -----------------------------------------------------
set_global_assignment -name SDC_FILE fft_stage_calib.sdc

# ---------------------------------------------------------------------------
# Virtual pins
# ---------------------------------------------------------------------------
# Same rationale as the benchmark project: this is a FABRIC measurement, not a
# pinout exercise. Every data and handshake port is a virtual pin so the Fitter
# places no I/O buffers and the register-to-register paths inside the wrapper are
# what gets measured. clk and rst_n stay real pins so they get genuine global
# networks — a kernel measured on a local clock tree would report an Fmax the
# real design can never reproduce.
set_instance_assignment -name VIRTUAL_PIN ON -to vld_in
set_instance_assignment -name VIRTUAL_PIN ON -to "din_re[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "din_im[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "idx_in[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to warm_in

set_instance_assignment -name VIRTUAL_PIN ON -to vld_out
set_instance_assignment -name VIRTUAL_PIN ON -to "dout_re[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "dout_im[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "idx_out[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to warm_out
set_instance_assignment -name VIRTUAL_PIN ON -to "flags[*]"
