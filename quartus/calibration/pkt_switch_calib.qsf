# ---------------------------------------------------------------------------
# pkt_switch_calib.qsf — SPEC 18 calibration project settings for one
# packet-switch stage (issue #18, SPEC 18 item 9).
#
# SAME DEVICE as the benchmark project (quartus/project/agilex7_wideband.qsf):
# AGMF039R47B1E1VC, same speed grade, same junction-temperature range. A
# calibration number measured on a different device or a different operating
# range is not calibration data for this benchmark, so the two files state the
# device identically and the exported record repeats it for every point.
#
# HAND MAINTAINED. quartus/scripts/calibrate.tcl lets Quartus export the
# in-memory assignment database over this file — it has to, because that export
# is how the swept `set_parameter` values reach quartus_syn — and then restores
# these exact bytes afterwards. So the sweep leaves no parameter, no seed and no
# tool bookkeeping behind. Do not open the project in the GUI and save it.
#
# All paths are relative to this directory (quartus/calibration/).
# ---------------------------------------------------------------------------

# --- device (SPEC.md 2, 15) -------------------------------------------------
set_global_assignment -name FAMILY "Agilex 7"
set_global_assignment -name DEVICE AGMF039R47B1E1VC
set_global_assignment -name TOP_LEVEL_ENTITY pkt_switch_wrap

set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100

# --- project output ---------------------------------------------------------
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

# --- simulation-only code exclusion -----------------------------------------
# Every module in rtl/packet/ guards its elaboration checks and its SPEC 14
# assertions with an `ifndef SYNTHESIS, the convention every primitive in this
# repository uses. Quartus does not define SYNTHESIS on its own, so the
# calibration project defines it explicitly rather than relying on the tool
# silently ignoring an initial block. Without this line the measured resource
# counts would include simulation scaffolding — including sync_fifo's shadow
# occupancy counters, which are two free-running 32-bit counters PER BUFFER and
# there are sixteen buffers in this switch.
set_global_assignment -name VERILOG_MACRO "SYNTHESIS=1"

# --- design source ----------------------------------------------------------
# Order matters: packages first. Every file is the SAME FILE the simulation
# builds and lints — there is no synthesis-only copy, which is the property that
# makes the calibration numbers apply to the verified design.
#
# fxp_pkg, covar_pkg and cfar_pkg are here because packet_pkg states the
# detection-event payload width by reference to cfar_pkg rather than by copy. No
# CFAR datapath is in this project.
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/fxp_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/covar_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/cfar_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packages/packet_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/common/perf_counter.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/common/sync_fifo.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packet/pkt_rr_arb.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/packet/pkt_switch_stage.sv
set_global_assignment -name SYSTEMVERILOG_FILE pkt_switch_wrap.sv

# --- timing constraints -----------------------------------------------------
set_global_assignment -name SDC_FILE pkt_switch_calib.sdc

# ---------------------------------------------------------------------------
# Virtual pins
# ---------------------------------------------------------------------------
# Same rationale as the benchmark project: this is a FABRIC measurement, not a
# pinout exercise. Every data and handshake port is a virtual pin so the Fitter
# places no I/O buffers and the register-to-register paths inside the wrapper are
# what gets measured. clk and rst_n stay real pins so they get genuine global
# networks — a kernel measured on a local clock tree would report an Fmax the
# real design can never reproduce.
#
# There are 4136 virtual data pins here (two 4 x 517-bit flit buses). That is the
# honest consequence of pricing a 512-bit fabric: the flit bus IS the block.
set_instance_assignment -name VIRTUAL_PIN ON -to "in_valid[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "in_flit[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "out_credit_in[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "fi_credit_kill[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to tel_clear

set_instance_assignment -name VIRTUAL_PIN ON -to "in_credit_out[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "out_valid[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "out_flit[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "tel_flits[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "tel_stall[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "tel_max_wait[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "tel_hiwater[*]"
