# ---------------------------------------------------------------------------
# cmult_calib.qpf — SPEC 18 resource-calibration project for the complex
# multiplier (issue #9).
#
# One revision. The sweep varies ELABORATION PARAMETERS, not revision settings,
# so a revision per point would create sixteen near-identical settings files
# whose only difference is three integers — and would put the sweep's state in
# tracked files instead of in the exported JSON record. scripts/run_calibration.py
# recompiles this single revision once per point and exports one record per
# point; the parameters that produced each record are IN the record. See
# DECISIONS.md (issue #9, calibration methodology).
#
# Hand-maintained: do not let the GUI rewrite this file with tool metadata.
# ---------------------------------------------------------------------------

QUARTUS_VERSION = "26.1"

# Revisions

PROJECT_REVISION = "cmult_calib"
